# Lenovo Active Pen / Tab Pen (Vendor 17ef Product 612b)
# Mapped to BUTTON_* keycodes so Android dispatches KeyEvents to PenBridge / Accessibility
key usage 0x0c0600   BUTTON_1
key usage 0x0c0601   BUTTON_2
key usage 0x0c0602   BUTTON_3
key usage 0x0c0603   BUTTON_4
key usage 0x0c0604   BUTTON_5
key usage 0x0c0605   BUTTON_6