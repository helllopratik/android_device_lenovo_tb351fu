# ── Lenovo Tab Plus 2024 (TB351FU) — kernel.config (A17-PROVEN fragment) ──
# Ground truth: final .config of the AUG build #15 kernel (6.12.15-4k+,
# clang 19 r536225, extracted from A17_stable_aug/boot.img) compared against
# the evox kernel tree's script-processed stock_config. This fragment
# reproduces exactly the deltas the proven kernel carried.
#
# Deliberately EXCLUDED (all pmOS-era additions that are NOT in the AUG config
# and were the regression root in #16):
#   - SCSI_UFS_MEDIATEK / PHY_MTK_UFS        (UFS = stock first-stage
#                                             ufs-mediatek-mod.ko from
#                                             vendor_ramdisk, not built-in)
#   - SECTION_MISMATCH_WARN_ONLY             (was a clang-r584948-only workaround)
#   - MMC_MTK / PWRSEQ_* / PINCTRL / SCMI / CMDQ, DRM_MEDIATEK / PANFROST /
#     PWM backlight, FB / VT / console, PARTITION_ADVANCED / EFI_PARTITION
#   - ARCH_MEDIATEK=y                         (kept OFF, see guard below)

# ── MTK feature disables (identical in AUG config and lineage proven base) ──
# CONFIG_MTK_GED is not set
# CONFIG_MTK_FPSGO_V3 is not set
# CONFIG_MTK_SCHED_EAS is not set
# CONFIG_MTK_TASK_TURBO is not set
# CONFIG_MTK_AEE_FEATURE is not set
# CONFIG_MTK_GKI_MT6789_COMMON is not set
# CONFIG_MTK_CCMNI is not set
# CONFIG_TRUSTONIC_TEE_SUPPORT is not set
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y

# ── GKI hardening parity (already baked into the tree stock_config by
#    build_stock_config.sh; repeated here so the fragment stays self-doc) ──
# CONFIG_TRIM_UNUSED_KSYMS is not set
# CONFIG_WERROR is not set

# ── Keep MediaTek SoC glue OUT of the GKI kernel (hard guard) ──────────────
# ARCH_MEDIATEK=y was the #16 regression root: it selected SCSI_UFS_MEDIATEK,
# PHY_MTK_UFS and pulled in the driver churn that broke stock module loading.
# AUG #15 built with it OFF (stock GKI). Do NOT enable CONFIG_SCSI_UFS_MEDIATEK
# here — it is absent from the AUG config; UFS is served by the stock first-stage
# ufs-mediatek-mod.ko from vendor_ramdisk (see kernel.config comments that used
# to live in the pmOS copy; that driver ships prebuilt in the ramdisk).
# CONFIG_ARCH_MEDIATEK is not set

# ── Rust off (AUG: RUST off; ASHMEM_RUST dies with it) ─────────────────────
# CONFIG_RUST is not set
CONFIG_CFI_ICALL_NORMALIZE_INTEGERS=y
CONFIG_CFI_PERMISSIVE=y
CONFIG_EXTENDED_MODVERSIONS=y

# ── Module signing off (AUG has MODULE_SIG / MODULE_SIG_ALL off) ───────────
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_ALL is not set
# CONFIG_SYSTEM_REVOCATION_LIST is not set

# ── Link behavior (AUG downgraded orphan-section errors to warnings) ───────
CONFIG_LD_ORPHAN_WARN_LEVEL="warn"
# CONFIG_DRM_WERROR is not set

# ── Touch: tp_nt36xxx.ko is a vendor_dlkm MODULE in the ROM (modules.load
#    line 1), never built in on AUG. The built-in hostdl variant was a pmOS
#    addition. ───────────────────────────────────────────────────────────────
# CONFIG_TOUCHSCREEN_NT36xxx_HOSTDL_SPI_OEM is not set

# ── Ashmem: C implementation (AUG); ASHMEM_RUST disappears with RUST off ────
CONFIG_ASHMEM_C=y

# ── fs-verity signatures: selects SYSTEM_DATA_VERIFICATION so that
#    verify_pkcs7_signature stays exported for the prebuilt MediaTek
#    cfg80211.ko. Keep CONFIG_MODVERSIONS=y (stock default, NOT disabled):
#    module/version.c with the patched same_magic/check_version is only
#    compiled under MODVERSIONS, and it is what lets stock modules with
#    6.12.23 vermagic load on this 6.12.15 kernel. ──────────────────────────
CONFIG_FS_VERITY_BUILTIN_SIGNATURES=y
CONFIG_ASN1=y
CONFIG_PKCS7_MESSAGE_PARSER=y