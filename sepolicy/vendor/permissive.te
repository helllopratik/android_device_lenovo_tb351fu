# Define custom vendor domains and exec types
type hal_lenovotouchscreen_default, domain;
type hal_lenovotouchscreen_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_lenovotouchscreen_default)

type ccci_mdinit, domain;
type ccci_mdinit_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(ccci_mdinit)

type ccci_rpcd, domain;
type ccci_rpcd_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(ccci_rpcd)

type wmt_loader, domain;
type wmt_loader_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(wmt_loader)

type fuelgauged, domain;
type fuelgauged_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(fuelgauged)

type nvram_daemon, domain;
type nvram_daemon_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(nvram_daemon)

type thermal, domain;
type thermal_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(thermal)

# Set permissive attributes (allowed only on userdebug or eng builds)
userdebug_or_eng(`
permissive hal_health_default;
permissive hal_lineage_health_default;
permissive hal_lenovotouchscreen_default;
permissive hal_audio_default;
permissive ccci_mdinit;
permissive ccci_rpcd;
permissive wmt_loader;
permissive fuelgauged;
permissive nvram_daemon;
permissive tee;

permissive hal_camera_default;
permissive hal_sensors_default;
permissive hal_light_default;
permissive hal_power_default;
permissive hal_graphics_composer_default;
permissive hal_graphics_allocator_default;
permissive hal_drm_widevine;
permissive thermal;
')

