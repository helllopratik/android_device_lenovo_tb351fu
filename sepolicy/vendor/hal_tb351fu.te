# Widevine DRM HAL
type hal_drm_widevine, domain;
hal_server_domain(hal_drm_widevine, hal_drm)

type hal_drm_widevine_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_drm_widevine)

allow hal_drm_widevine widevine_drv_device:chr_file rw_file_perms;
allow hal_drm_widevine mediadrm_vendor_data_file:dir create_dir_perms;
allow hal_drm_widevine mediadrm_vendor_data_file:file create_file_perms;
allow hal_drm_widevine tee_device:chr_file rw_file_perms;
allow hal_drm_widevine hal_allocator_server:fd use;
allow hal_drm mediacodec:fd use;
allow mediaserver widevine_drv_device:chr_file rw_file_perms;
vndbinder_use(hal_drm_widevine);
hal_client_domain(hal_drm_widevine, hal_graphics_composer);

# Sensors HAL
allow hal_sensors_default hf_manager_device:chr_file rw_file_perms;

# Audio HAL & SmartPA
allow hal_audio_default aw_smartpa_device:chr_file rw_file_perms;

# Lights HAL & Backlight / Flashlight
allow hal_light_default flashlight_device:chr_file rw_file_perms;
allow hal_light_default sysfs_leds:file rw_file_perms;
allow hal_light_default sysfs:file rw_file_perms;

# Health HAL & Battery status
allow hal_health_default sysfs:file r_file_perms;

# Graphics Composer UEvent socket
allow hal_graphics_composer_default self:netlink_kobject_uevent_socket { read create setopt bind };

# Thermal & FPSGO
allow thermal proc:file { ioctl read write open getattr };
