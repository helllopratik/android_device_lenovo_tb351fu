<?xml version="1.0" encoding="utf-8"?>
<!-- Device configuration overlay for TB351FU -->
<resources>
    <!-- Force software navigation bar (tablet has no hardware nav keys) -->
    <bool name="config_showNavigationBar">true</bool>

    <!-- Disable PocketService to prevent SELinux crashes on tablets -->
    <bool name="config_pocketModeSupported">false</bool>

    <!-- Disable window blurs to prevent SurfaceFlinger Mapper error 7 contrast overlay on volume dialog -->
    <bool name="config_windowEnableBlurs">false</bool>

    <!-- Enable auto-brightness -->
    <bool name="config_automatic_brightness_available">true</bool>

    <!-- Enable stylus/pen support -->
    <bool name="config_stylusGesturesEnabled">true</bool>
    <bool name="config_stylusHandwritingSupported">true</bool>

    <!-- Tablet-specific configs -->
    <bool name="config_ui_enableWifiOverlay">true</bool>
    <bool name="config_deviceHasVariableButtonBacklight">false</bool>
    <integer name="config_screenBrightnessSettingDefault">120</integer>
    <!-- Brightness floor: hardware backlight floor is 3 (out of 255).
         In stock ZUI, slider minimum maps to backlight 3 (0.007874016f normalized float).
         Setting config_screenBrightnessSettingMinimum to 3 and minimum float to -2 ensures
         DisplayDeviceConfig mBacklightMinimum = 0.007874016f, matching rawBacklight[0] = 3.
         This prevents the IllegalStateException boot crash while keeping the screen visible
         when the brightness slider is pulled to 0. -->
    <integer name="config_screenBrightnessSettingMinimum">3</integer>
    <integer name="config_screenBrightnessDark">3</integer>
    <integer name="config_screenBrightnessDim">3</integer>
    <integer name="config_screenBrightnessSettingMaximum">255</integer>
    <item name="config_screenBrightnessSettingMinimumFloat" format="float" type="dimen">-2</item>
    <item name="config_screenBrightnessSettingMaximumFloat" format="float" type="dimen">-2</item>
    <item name="config_screenBrightnessSettingDefaultFloat" format="float" type="dimen">0.5</item>
    <item name="config_screenBrightnessDimFloat" format="float" type="dimen">0.05</item>
    <bool name="config_enableScreenshotChord">true</bool>
    <bool name="config_hasRemovableLid">false</bool>

    <!-- Sensor configurations -->
    <bool name="config_sensor_adjustable">true</bool>
    <bool name="config_setColorTransformAccelerated">true</bool>

    <!-- Configure the light sensor type expected by AOSP display controller -->
    <!-- ZUI stock RRO uses "defaultlightsensor". Since we use the raw sensor list, setting it empty defaults to Sensor.TYPE_LIGHT, which binds to mn29xxx_l -->
    <string name="config_displayLightSensorType" translatable="false"></string>

    <!-- Auto-brightness debounce (4000ms from stock ZUI) -->
    <integer name="config_autoBrightnessBrighteningLightDebounce">4000</integer>
    <integer name="config_autoBrightnessDarkeningLightDebounce">4000</integer>

    <!-- Array of light consumer (lux) levels to define brightness steps (Stock ZUI calibration) -->
    <integer-array name="config_autoBrightnessLevels">
        <item>10</item>
        <item>60</item>
        <item>210</item>
        <item>350</item>
        <item>420</item>
        <item>1000</item>
    </integer-array>

    <!-- Array of output nits values corresponding to the lux levels (Stock ZUI calibration) -->
    <array name="config_autoBrightnessDisplayValuesNits">
        <item>0</item>
        <item>40</item>
        <item>100</item>
        <item>150</item>
        <item>300</item>
        <item>420</item>
        <item>490</item>
    </array>

    <!-- Array of backlight values (0-255) corresponding to the nits values (Stock ZUI calibration) -->
    <integer-array name="config_screenBrightnessBacklight">
        <item>3</item>
        <item>26</item>
        <item>64</item>
        <item>96</item>
        <item>191</item>
        <item>255</item>
        <item>255</item>
    </integer-array>

    <!-- Array of screen brightness nits values (Stock ZUI calibration) -->
    <array name="config_screenBrightnessNits">
        <item>0</item>
        <item>40</item>
        <item>100</item>
        <item>150</item>
        <item>300</item>
        <item>420</item>
        <item>490</item>
    </array>

    <!-- Default peak refresh rate (90Hz) -->
    <integer name="config_defaultPeakRefreshRate">90</integer>

    <!-- Use input events for headphone jack detection -->
    <bool name="config_useDevInputEventForAudioJack">true</bool>

    <!-- Device is not voice capable (WiFi-only tablet) -->
    <bool name="config_voice_capable">false</bool>
    <bool name="config_sms_capable">false</bool>

    <!-- Enable freeform window management and multi-window support -->
    <bool name="config_freeformWindowManagement">true</bool>
    <bool name="config_supportsMultiWindow">true</bool>

    <!-- Desktop Mode support (Android 15+) -->
    <bool name="config_isDesktopModeSupported">true</bool>
    <bool name="config_isDesktopModeDevOptionSupported">true</bool>
    <bool name="config_canInternalDisplayHostDesktops">true</bool>
</resources>
